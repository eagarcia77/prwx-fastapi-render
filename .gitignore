# Keep sample data; raw archives can become very large.
data/raw/*
!data/raw/.gitkeep
# Historical PR-CARIBE training tables are generated locally/externally and can be very large.
data/training/*.parquet
data/training/observations_*.csv
data/training/gfs_*.csv
data/training/gefs_*.csv
data/training/nam_pr_*.csv
data/training/pr_caribbean_training.csv
# Historical storm-track AI data is downloaded/generated by workflow artifacts, not committed.
data/training/raw/*
!data/training/raw/.gitkeep
data/training/storm_tracks_atlantic_training.csv
data/training/storm_tracks_atlantic_training.parquet
data/processed/storm_historical_training_v30.json
data/processed/storm_historical_sources_v30.json
data/processed/storm_pr_trajectory_ai_v30.json
reports/storm_training_artifact_manifest_v31.json
# Small JSON manifests may be committed intentionally for provenance.
